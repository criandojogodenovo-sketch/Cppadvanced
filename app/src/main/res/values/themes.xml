<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema DayNight: as cores semânticas trocam automaticamente entre values/ e values-night/ -->
    <style name="Theme.CppStudio" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorOnPrimary">#0C0C0E</item>
        <item name="colorPrimaryContainer">@color/orange_bright</item>
        <item name="colorOnPrimaryContainer">#0C0C0E</item>
        <item name="colorSecondary">@color/orange_primary</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/text_c</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/bg_color</item>
        <item name="android:statusBarColor">@color/bg_color</item>
        <item name="android:navigationBarColor">@color/bg_color</item>
        <item name="android:textColorPrimary">@color/text_c</item>
        <item name="android:textColorSecondary">@color/text2_c</item>
        <item name="android:textColorTertiary">@color/text2_c</item>
    </style>

    <style name="TextAppearance.CppStudio.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_c</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.CppStudio.SymbolButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/orange_primary</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
</resources>
