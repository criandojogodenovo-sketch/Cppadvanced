<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_color">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_color"
        app:title="@string/project_settings_title"
        app:titleTextColor="@color/text_c" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_info"
                android:textColor="@color/orange_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/projectInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text2_c"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cpp_standard"
                android:textColor="@color/text_c"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/stdGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/std17"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="C++17 (recomendado)"
                    android:textColor="@color/text_c" />

                <RadioButton
                    android:id="@+id/std20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C++20 (se a toolchain instalada suportar)"
                    android:textColor="@color/text_c" />

                <RadioButton
                    android:id="@+id/std23"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C++23 (experimental — depende do compilador)"
                    android:textColor="@color/text_c" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/build_system"
                android:textColor="@color/text_c"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/buildGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/buildSingle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ficheiro(s) direto(s) — clang direto"
                    android:textColor="@color/text_c" />

                <RadioButton
                    android:id="@+id/buildCmake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CMake (CMakeLists.txt)"
                    android:textColor="@color/text_c" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/missing_requirements"
                android:textColor="@color/orange_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/missingReqs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/warning_yellow"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveProject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/orange_primary"
                android:text="@string/save_changes"
                android:textColor="#0C0C0E" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
