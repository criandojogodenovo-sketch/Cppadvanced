<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/project_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/projectNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:maxLength="64" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/project_template"
        android:textColor="@color/text2_c"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/templateGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <RadioButton
            android:id="@+id/tplConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Consola C++17 (main.cpp)"
            android:textColor="@color/text_c" />

        <RadioButton
            android:id="@+id/tplCMakeMulti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CMake multi-ficheiro (src/ + include/)"
            android:textColor="@color/text_c" />

        <RadioButton
            android:id="@+id/tplStaticLib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Biblioteca estática C++ (CMake)"
            android:textColor="@color/text_c" />

        <RadioButton
            android:id="@+id/tplC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ficheiro único C (main.c)"
            android:textColor="@color/text_c" />
    </RadioGroup>

</LinearLayout>
